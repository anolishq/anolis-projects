# One heartbeat: scripts/run_heartbeat.py, installed by install-run-heartbeat.sh.
# Started every minute by run-heartbeat.timer.
[Unit]
Description=Anolis run heartbeat (one check, one ping)
After=network-online.target anolis-runtime.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/anolis/runtime.env
EnvironmentFile=/etc/anolis/heartbeat.env
ExecStart=/usr/bin/python3 /usr/local/libexec/anolis/run_heartbeat.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
